{
  "openapi": "3.1.0",
  "info": {
    "title": "Swellwright API",
    "version": "0.1.0",
    "description": "Deploy and operate Remnawave fleets. Unofficial community project.",
    "license": {
      "name": "AGPL-3.0-only",
      "identifier": "AGPL-3.0-only"
    }
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "tags": [
    {
      "name": "system",
      "description": "Probes, version and the API description."
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "tags": [
          "system"
        ],
        "summary": "Liveness probe",
        "responses": {
          "200": {
            "description": "The process is alive.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "description": "Answers while the process serves requests. It does not check dependencies.",
        "security": []
      }
    },
    "/ready": {
      "get": {
        "operationId": "getReady",
        "tags": [
          "system"
        ],
        "summary": "Readiness probe",
        "responses": {
          "200": {
            "description": "Every configured dependency answers.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            }
          },
          "503": {
            "description": "At least one dependency is down.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "description": "Checks every configured dependency. Answers 503 with the same body shape when one is down.",
        "security": []
      }
    },
    "/version": {
      "get": {
        "operationId": "getVersion",
        "tags": [
          "system"
        ],
        "summary": "Build and API version",
        "responses": {
          "200": {
            "description": "Version information.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "getOpenApi",
        "tags": [
          "system"
        ],
        "summary": "This API description",
        "responses": {
          "200": {
            "description": "The OpenAPI document.",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              }
            }
          },
          "default": {
            "description": "Error envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "description": "The OpenAPI 3.1 document generated from the route registry.",
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorCode": {
        "type": "string",
        "enum": [
          "bad_request",
          "validation_failed",
          "unauthorized",
          "forbidden",
          "not_found",
          "conflict",
          "rate_limited",
          "not_ready",
          "internal_error"
        ]
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "$ref": "#/components/schemas/ErrorCode"
              },
              "message": {
                "type": "string",
                "description": "Human-readable text for logs and developers, not for branching."
              },
              "requestId": {
                "type": "string",
                "description": "Also sent in the x-request-id response header."
              },
              "details": {
                "description": "Optional structured details, for example validation issues."
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "description": "Error envelope."
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false,
        "description": "Liveness probe result."
      },
      "CheckResult": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          },
          "latencyMs": {
            "type": "number",
            "minimum": 0,
            "description": "How long the check took, in milliseconds."
          },
          "error": {
            "description": "Short reason when the check is down; never contains secrets.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "latencyMs"
        ],
        "additionalProperties": false
      },
      "ReadyResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "not_ready"
            ]
          },
          "checks": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "$ref": "#/components/schemas/CheckResult"
            },
            "description": "One entry per configured dependency."
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "additionalProperties": false,
        "description": "Readiness probe result."
      },
      "VersionResponse": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "const": "swellwright"
          },
          "version": {
            "type": "string",
            "description": "Semantic version of the running build."
          },
          "apiVersion": {
            "type": "string",
            "const": "v1"
          },
          "commit": {
            "description": "Source revision, when the build embeds it.",
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "apiVersion"
        ],
        "additionalProperties": false,
        "description": "Build and API version."
      }
    },
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sw_session"
      },
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
