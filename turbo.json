{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "src/generated/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build"],
      "env": ["SW_TEST_DATABASE_URL", "SW_TEST_DATABASE_POOL", "SW_TEST_VALKEY_URL"]
    }
  }
}
