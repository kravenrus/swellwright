// Swellwright data model. The design is docs/en/design/02-data-model.md; this file grows entity by entity.
// Tables and columns are snake_case in the database and camelCase in the client.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

/// Built-in roles (docs/en/design/05-security.md). Their permission sets live in packages/contracts (ADR 0015);
/// custom roles come with user management.
enum UserRole {
  owner
  operator
  observer
  terminal
  auditor

  @@map("user_role")
}

enum UserStatus {
  active
  disabled

  @@map("user_status")
}

/// How far a session got. `password_verified` is usable only to finish signing in.
enum SessionStage {
  password_verified
  active

  @@map("session_stage")
}

model User {
  id          String     @id @default(uuid(7)) @db.Uuid
  /// Login name. Stored lower-case: the application normalizes it before every write.
  username    String     @unique @db.VarChar(32)
  displayName String?    @map("display_name") @db.VarChar(100)
  /// Optional. Stored lower-case, like the username.
  email       String?    @unique @db.VarChar(254)
  role        UserRole
  status      UserStatus @default(active)
  language    String     @default("en") @db.VarChar(16)
  theme       String     @default("dark") @db.VarChar(16)
  lastLoginAt DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  credential    Credential?
  recoveryCodes RecoveryCode[]
  sessions      Session[]
  invitation    Invitation?

  @@map("users")
}

/// Why an invitation was issued: a new user, or a reset of an existing one's credentials (ADR 0016).
enum InvitationPurpose {
  invite
  reset

  @@map("invitation_purpose")
}

/// The one open invitation of a user: a one-time token to choose a password. Only the SHA-256 of the token
/// is stored; the row is deleted when the token is used, and a new invitation replaces the old one.
model Invitation {
  id          String            @id @default(uuid(7)) @db.Uuid
  userId      String            @unique @map("user_id") @db.Uuid
  tokenHash   String            @unique @map("token_hash") @db.VarChar(64)
  purpose     InvitationPurpose
  expiresAt   DateTime          @map("expires_at") @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  /// The owner who issued it; null when it came from the server command. No foreign key, like the audit chain.
  createdById String?           @map("created_by_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("invitations")
}

/// Sign-in secrets of one user (docs/en/design/02-data-model.md, ADR 0014).
model Credential {
  userId            String    @id @map("user_id") @db.Uuid
  /// Argon2id hash in PHC string format; carries its own salt and parameters.
  passwordHash      String    @map("password_hash")
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  /// TOTP secret sealed with the instance authentication key (AES-256-GCM). Null until enrollment starts.
  totpSecret        Bytes?    @map("totp_secret")
  /// Set when the user proved they hold the authenticator. Until then the secret is only a proposal.
  totpConfirmedAt   DateTime? @map("totp_confirmed_at") @db.Timestamptz(3)
  /// Time step of the last accepted code; a code is accepted only for a later step (no replay).
  totpLastStep      Int?      @map("totp_last_step")
  /// Consecutive failures of the password or the second step; reset on a completed sign-in.
  failedAttempts    Int       @default(0) @map("failed_attempts")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credentials")
}

/// One-time codes for a lost authenticator. Only SHA-256 hashes are stored.
model RecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.VarChar(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("recovery_codes")
}

/// What happened to an action an audit event describes.
enum AuditOutcome {
  success
  failure
  denied

  @@map("audit_outcome")
}

/// One row of the append-only audit chain (docs/adr/0015-permissions-and-the-audit-chain.md). Nothing here
/// points at another table on purpose: the record must outlive the user it names. The migration installs
/// triggers that refuse UPDATE, DELETE and TRUNCATE; they are not part of this schema, so do not drop them.
model AuditEvent {
  /// Position in the chain, from 1, assigned under a lock so there are no gaps.
  seq        BigInt       @id
  occurredAt DateTime     @map("occurred_at") @db.Timestamptz(3)
  actorId    String?      @map("actor_id") @db.Uuid
  /// The login name when the event happened.
  actorName  String?      @map("actor_name") @db.VarChar(64)
  action     String       @db.VarChar(64)
  outcome    AuditOutcome
  objectType String?      @map("object_type") @db.VarChar(32)
  objectId   String?      @map("object_id") @db.VarChar(64)
  ip         String?      @db.VarChar(64)
  requestId  String?      @map("request_id") @db.VarChar(64)
  /// Canonical JSON text, exactly what the hash covers. Text, not jsonb: reading it back must not reorder it.
  details    String       @default("{}")
  prevHash   String       @map("prev_hash") @db.VarChar(64)
  hash       String       @unique @db.VarChar(64)

  @@index([action, seq])
  @@index([actorId, seq])
  @@map("audit_events")
}

/// What a secret is for (docs/en/design/02-data-model.md). A closed list; a new kind is a migration.
enum SecretType {
  panel_token
  ssh_key
  ssh_password
  ssh_ca
  dns_oauth
  provider_token
  telegram
  generic

  @@map("secret_type")
}

/// The one row that says how the vault opens (docs/adr/0018). The KEK is random; it is stored wrapped twice,
/// under a key derived from the owner's passphrase and under the recovery key. Never the KEK itself.
model VaultMeta {
  /// Always 1: the migration adds a check that there is only one row.
  id                  Int      @id @default(1)
  kdfSalt             Bytes    @map("kdf_salt")
  /// Argon2id parameters, kept so they can be raised later without losing the ability to open the vault.
  kdfMemoryKib        Int      @map("kdf_memory_kib")
  kdfPasses           Int      @map("kdf_passes")
  kdfParallelism      Int      @map("kdf_parallelism")
  passphraseWrappedKek Bytes   @map("passphrase_wrapped_kek")
  recoveryWrappedKek  Bytes    @map("recovery_wrapped_kek")
  kekVersion          Int      @default(1) @map("kek_version")
  /// When each part of the vault was last rotated (ADR 0024). Null: never since the vault was set up.
  passphraseChangedAt  DateTime? @map("passphrase_changed_at") @db.Timestamptz(3)
  recoveryKeyRotatedAt DateTime? @map("recovery_key_rotated_at") @db.Timestamptz(3)
  kekRotatedAt         DateTime? @map("kek_rotated_at") @db.Timestamptz(3)
  dataKeysRotatedAt    DateTime? @map("data_keys_rotated_at") @db.Timestamptz(3)
  /// The owner who set the vault up. No foreign key, like the audit chain.
  createdById         String?  @map("created_by_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("vault_meta")
}

/// One secret. The value is encrypted with its own data key, which is wrapped under the KEK; the name, type
/// and dates are not secret. Only the metadata is ever returned by a list.
model Secret {
  id             String     @id @default(uuid(7)) @db.Uuid
  name           String     @unique @db.VarChar(100)
  type           SecretType
  description    String?    @db.VarChar(500)
  /// Moves forward with every new value; part of what the blobs are bound to.
  version        Int        @default(1)
  /// AES-256-GCM under the data key.
  ciphertext     Bytes
  /// The data key, AES-256-GCM under the KEK.
  wrappedDek     Bytes      @map("wrapped_dek")
  expiresAt      DateTime?  @map("expires_at") @db.Timestamptz(3)
  createdById    String?    @map("created_by_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// When the value last changed (created or replaced), as opposed to the metadata.
  valueChangedAt DateTime   @default(now()) @map("value_changed_at") @db.Timestamptz(3)

  @@index([type])
  @@map("secrets")
}

/// A browser session. The cookie holds a random token; only its SHA-256 hash is stored.
model Session {
  id                String       @id @default(uuid(7)) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  tokenHash         String       @unique @map("token_hash") @db.VarChar(64)
  stage             SessionStage
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime     @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  /// Idle expiry, moved forward while the session is used.
  expiresAt         DateTime     @map("expires_at") @db.Timestamptz(3)
  /// The session ends here whatever its activity.
  absoluteExpiresAt DateTime     @map("absolute_expires_at") @db.Timestamptz(3)
  /// The session counts as freshly verified until then (step-up authentication, ADR 0017). Null: never elevated.
  elevatedUntil     DateTime?    @map("elevated_until") @db.Timestamptz(3)
  ip                String?      @db.VarChar(64)
  userAgent         String?      @map("user_agent") @db.VarChar(256)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}
