// Swellwright data model. The design is docs/en/design/02-data-model.md; this file grows entity by entity.
// Tables and columns are snake_case in the database and camelCase in the client.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

/// Built-in roles (docs/en/design/05-security.md). Their permission sets live in packages/contracts (ADR 0015);
/// custom roles come with user management.
enum UserRole {
  owner
  operator
  observer
  terminal
  auditor

  @@map("user_role")
}

enum UserStatus {
  active
  disabled

  @@map("user_status")
}

/// How far a session got. `password_verified` is usable only to finish signing in.
enum SessionStage {
  password_verified
  active

  @@map("session_stage")
}

model User {
  id          String     @id @default(uuid(7)) @db.Uuid
  /// Login name. Stored lower-case: the application normalizes it before every write.
  username    String     @unique @db.VarChar(32)
  displayName String?    @map("display_name") @db.VarChar(100)
  /// Optional. Stored lower-case, like the username.
  email       String?    @unique @db.VarChar(254)
  role        UserRole
  status      UserStatus @default(active)
  /// The language the person chose; null until they do (the console then follows the browser, ADR 0026).
  language    String?    @db.VarChar(16)
  theme       String     @default("dark") @db.VarChar(16)
  lastLoginAt DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  credential    Credential?
  recoveryCodes RecoveryCode[]
  sessions      Session[]
  invitation    Invitation?
  apiTokens     ApiToken[]

  @@map("users")
}

/// Why an invitation was issued: a new user, or a reset of an existing one's credentials (ADR 0016).
enum InvitationPurpose {
  invite
  reset

  @@map("invitation_purpose")
}

/// The one open invitation of a user: a one-time token to choose a password. Only the SHA-256 of the token
/// is stored; the row is deleted when the token is used, and a new invitation replaces the old one.
model Invitation {
  id          String            @id @default(uuid(7)) @db.Uuid
  userId      String            @unique @map("user_id") @db.Uuid
  tokenHash   String            @unique @map("token_hash") @db.VarChar(64)
  purpose     InvitationPurpose
  expiresAt   DateTime          @map("expires_at") @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  /// The owner who issued it; null when it came from the server command. No foreign key, like the audit chain.
  createdById String?           @map("created_by_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("invitations")
}

/// Sign-in secrets of one user (docs/en/design/02-data-model.md, ADR 0014).
model Credential {
  userId            String    @id @map("user_id") @db.Uuid
  /// Argon2id hash in PHC string format; carries its own salt and parameters.
  passwordHash      String    @map("password_hash")
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  /// TOTP secret sealed with the instance authentication key (AES-256-GCM). Null until enrollment starts.
  totpSecret        Bytes?    @map("totp_secret")
  /// Set when the user proved they hold the authenticator. Until then the secret is only a proposal.
  totpConfirmedAt   DateTime? @map("totp_confirmed_at") @db.Timestamptz(3)
  /// Time step of the last accepted code; a code is accepted only for a later step (no replay).
  totpLastStep      Int?      @map("totp_last_step")
  /// Consecutive failures of the password or the second step; reset on a completed sign-in.
  failedAttempts    Int       @default(0) @map("failed_attempts")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credentials")
}

/// One-time codes for a lost authenticator. Only SHA-256 hashes are stored.
model RecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.VarChar(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("recovery_codes")
}

/// What happened to an action an audit event describes.
enum AuditOutcome {
  success
  failure
  denied

  @@map("audit_outcome")
}

/// One row of the append-only audit chain (docs/adr/0015-permissions-and-the-audit-chain.md). Nothing here
/// points at another table on purpose: the record must outlive the user it names. The migration installs
/// triggers that refuse UPDATE, DELETE and TRUNCATE; they are not part of this schema, so do not drop them.
model AuditEvent {
  /// Position in the chain, from 1, assigned under a lock so there are no gaps.
  seq        BigInt       @id
  occurredAt DateTime     @map("occurred_at") @db.Timestamptz(3)
  actorId    String?      @map("actor_id") @db.Uuid
  /// The login name when the event happened.
  actorName  String?      @map("actor_name") @db.VarChar(64)
  action     String       @db.VarChar(64)
  outcome    AuditOutcome
  objectType String?      @map("object_type") @db.VarChar(32)
  objectId   String?      @map("object_id") @db.VarChar(64)
  ip         String?      @db.VarChar(64)
  requestId  String?      @map("request_id") @db.VarChar(64)
  /// Canonical JSON text, exactly what the hash covers. Text, not jsonb: reading it back must not reorder it.
  details    String       @default("{}")
  prevHash   String       @map("prev_hash") @db.VarChar(64)
  hash       String       @unique @db.VarChar(64)

  @@index([action, seq])
  @@index([actorId, seq])
  @@map("audit_events")
}

/// What a secret is for (docs/en/design/02-data-model.md). A closed list; a new kind is a migration.
enum SecretType {
  panel_token
  ssh_key
  ssh_password
  ssh_ca
  dns_oauth
  provider_token
  telegram
  generic

  @@map("secret_type")
}

/// The one row that says how the vault opens (docs/adr/0018). The KEK is random; it is stored wrapped twice,
/// under a key derived from the owner's passphrase and under the recovery key. Never the KEK itself.
model VaultMeta {
  /// Always 1: the migration adds a check that there is only one row.
  id                  Int      @id @default(1)
  kdfSalt             Bytes    @map("kdf_salt")
  /// Argon2id parameters, kept so they can be raised later without losing the ability to open the vault.
  kdfMemoryKib        Int      @map("kdf_memory_kib")
  kdfPasses           Int      @map("kdf_passes")
  kdfParallelism      Int      @map("kdf_parallelism")
  passphraseWrappedKek Bytes   @map("passphrase_wrapped_kek")
  recoveryWrappedKek  Bytes    @map("recovery_wrapped_kek")
  kekVersion          Int      @default(1) @map("kek_version")
  /// When each part of the vault was last rotated (ADR 0024). Null: never since the vault was set up.
  passphraseChangedAt  DateTime? @map("passphrase_changed_at") @db.Timestamptz(3)
  recoveryKeyRotatedAt DateTime? @map("recovery_key_rotated_at") @db.Timestamptz(3)
  kekRotatedAt         DateTime? @map("kek_rotated_at") @db.Timestamptz(3)
  dataKeysRotatedAt    DateTime? @map("data_keys_rotated_at") @db.Timestamptz(3)
  /// The owner who set the vault up. No foreign key, like the audit chain.
  createdById         String?  @map("created_by_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("vault_meta")
}

/// One secret. The value is encrypted with its own data key, which is wrapped under the KEK; the name, type
/// and dates are not secret. Only the metadata is ever returned by a list.
model Secret {
  id             String     @id @default(uuid(7)) @db.Uuid
  name           String     @unique @db.VarChar(100)
  type           SecretType
  description    String?    @db.VarChar(500)
  /// Moves forward with every new value; part of what the blobs are bound to.
  version        Int        @default(1)
  /// AES-256-GCM under the data key.
  ciphertext     Bytes
  /// The data key, AES-256-GCM under the KEK.
  wrappedDek     Bytes      @map("wrapped_dek")
  expiresAt      DateTime?  @map("expires_at") @db.Timestamptz(3)
  createdById    String?    @map("created_by_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// When the value last changed (created or replaced), as opposed to the metadata.
  valueChangedAt DateTime   @default(now()) @map("value_changed_at") @db.Timestamptz(3)

  /// The access entries of servers that log in with this secret, and those that use it as the sudo password.
  /// Both relations restrict: a secret in use cannot be deleted (ADR 0034).
  serverAccess     ServerAccess[] @relation("ServerAccessSecret")
  serverSudoAccess ServerAccess[] @relation("ServerAccessSudoSecret")

  @@index([type])
  @@map("secrets")
}

/// A browser session. The cookie holds a random token; only its SHA-256 hash is stored.
model Session {
  id                String       @id @default(uuid(7)) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  tokenHash         String       @unique @map("token_hash") @db.VarChar(64)
  stage             SessionStage
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime     @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  /// Idle expiry, moved forward while the session is used.
  expiresAt         DateTime     @map("expires_at") @db.Timestamptz(3)
  /// The session ends here whatever its activity.
  absoluteExpiresAt DateTime     @map("absolute_expires_at") @db.Timestamptz(3)
  /// The session counts as freshly verified until then (step-up authentication, ADR 0017). Null: never elevated.
  elevatedUntil     DateTime?    @map("elevated_until") @db.Timestamptz(3)
  ip                String?      @db.VarChar(64)
  userAgent         String?      @map("user_agent") @db.VarChar(256)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// An API token (ADR 0023): a bearer credential for the CLI and integrations, issued in the name of a user. Only
/// the SHA-256 hash of the token is kept; the token itself is shown once at creation.
model ApiToken {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  name        String    @db.VarChar(64)
  tokenHash   String    @unique @map("token_hash") @db.VarChar(64)
  /// The first characters of the token, so a person can recognise it in a list. Not enough to guess it.
  prefix      String    @db.VarChar(16)
  /// What the token may do: a subset of the permissions of the owner, never one that needs a step-up.
  permissions String[]
  /// CIDR ranges the token may be used from. Empty: from anywhere.
  ipAllowlist String[]  @map("ip_allowlist")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(3)
  lastUsedIp  String?   @map("last_used_ip") @db.VarChar(64)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_tokens")
}

/// What an administrator approved for a plugin: its files, by digest, and the permissions of its manifest at that
/// moment (ADR 0027). A plugin runs only while it is `enabled` and its files still have this digest.
model PluginApproval {
  pluginId    String   @id @map("plugin_id") @db.VarChar(48)
  enabled     Boolean
  version     String   @db.VarChar(64)
  trust       String   @db.VarChar(16)
  /// SHA-256 over every file of the plugin.
  digest      String   @db.VarChar(64)
  /// The approved permissions: the canonical JSON text of the manifest's `permissions`.
  permissions String
  approvedAt  DateTime @map("approved_at") @db.Timestamptz(3)
  /// The user name at the time. No foreign key, like the audit log: deleting the user does not erase who approved.
  approvedBy  String   @map("approved_by") @db.VarChar(64)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("plugin_approvals")
}

/// What an administrator entered in a plugin's settings (ADR 0029). A secret field holds the id of a vault secret,
/// never its value.
model PluginConfig {
  pluginId  String   @id @map("plugin_id") @db.VarChar(48)
  /// The settings as canonical JSON text.
  settings  String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// The user name at the time. No foreign key, like the audit log.
  updatedBy String   @map("updated_by") @db.VarChar(64)

  @@map("plugin_configs")
}

/// A plugin's own key-value storage (ADR 0029): no other plugin and no part of the core reads it.
model PluginStorageItem {
  pluginId  String   @map("plugin_id") @db.VarChar(48)
  key       String   @db.VarChar(128)
  /// JSON text.
  value     String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([pluginId, key])
  @@map("plugin_storage")
}

/// Where a server is in its life (docs/en/design/02-data-model.md). Any state may follow any other; the workflows of
/// later phases will constrain that where it matters.
enum ServerState {
  draft
  provisioning
  active
  draining
  retired

  @@map("server_state")
}

/// How Swellwright logs in to a server. Certificates come later, with a migration.
enum AccessMethod {
  password
  key

  @@map("access_method")
}

/// A server of the fleet: what it is and how to reach it (ADR 0034). What was found on it is a `ServerFact`.
model Server {
  id          String      @id @default(uuid(7)) @db.Uuid
  name        String      @unique @db.VarChar(64)
  /// A host name, an IPv4 or an IPv6 address; what SSH connects to.
  address     String      @db.VarChar(255)
  sshPort     Int         @default(22) @map("ssh_port")
  /// ISO 3166-1 alpha-2, upper case.
  country     String?     @db.VarChar(2)
  provider    String?     @db.VarChar(64)
  state       ServerState @default(draft)
  tags        String[]
  notes       String?     @db.VarChar(2000)
  /// The user who added it. No foreign key, like the audit chain: removing the user keeps the server.
  createdById String?     @map("created_by_id") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  hostKeys  ServerHostKey[]
  access    ServerAccess[]
  fact      ServerFact?
  artifacts ServerArtifact[]

  @@index([state])
  @@index([tags], type: Gin)
  @@map("servers")
}

/// A pinned SSH host key of a server. A connection is trusted only when the key it shows is pinned here.
model ServerHostKey {
  id                String   @id @default(uuid(7)) @db.Uuid
  serverId          String   @map("server_id") @db.Uuid
  /// The key type as OpenSSH names it, for example `ssh-ed25519`.
  algorithm         String   @db.VarChar(32)
  /// OpenSSH style: `SHA256:` and 43 base64 characters, no padding.
  fingerprintSha256 String   @map("fingerprint_sha256") @db.VarChar(50)
  /// How the key got here: `manual` (typed in) now; `scan` when the SSH layer reads it from the server.
  source            String   @default("manual") @db.VarChar(16)
  /// The user who pinned it. No foreign key, like the audit chain.
  acceptedById      String?  @map("accepted_by_id") @db.Uuid
  acceptedAt        DateTime @default(now()) @map("accepted_at") @db.Timestamptz(3)

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, fingerprintSha256])
  @@map("server_host_keys")
}

/// One way to log in to a server. Holds references to vault secrets, never a value; the secrets cannot be deleted
/// while an entry names them.
model ServerAccess {
  id             String       @id @default(uuid(7)) @db.Uuid
  serverId       String       @map("server_id") @db.Uuid
  method         AccessMethod
  username       String       @db.VarChar(64)
  /// The password (`ssh_password`) or the private key (`ssh_key`), by method.
  secretId       String       @map("secret_id") @db.Uuid
  /// The password to use for `sudo` (`ssh_password`), when it differs from the login.
  sudoSecretId   String?      @map("sudo_secret_id") @db.Uuid
  /// Lower first: the order in which the entries are tried.
  priority       Int          @default(0)
  /// When the entry was last tried (the verify operation) and whether it logged in and ran its checks.
  lastVerifiedAt DateTime?    @map("last_verified_at") @db.Timestamptz(3)
  lastVerifyOk   Boolean?     @map("last_verify_ok")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  server     Server  @relation(fields: [serverId], references: [id], onDelete: Cascade)
  secret     Secret  @relation("ServerAccessSecret", fields: [secretId], references: [id], onDelete: Restrict)
  sudoSecret Secret? @relation("ServerAccessSudoSecret", fields: [sudoSecretId], references: [id], onDelete: Restrict)

  @@index([serverId, priority])
  @@index([secretId])
  @@index([sudoSecretId])
  @@map("server_access")
}

/// What was found on a server, as JSON, and when and how. Empty until the SSH layer collects facts.
model ServerFact {
  serverId     String   @id @map("server_id") @db.Uuid
  facts        Json
  collectedAt  DateTime @map("collected_at") @db.Timestamptz(3)
  /// What produced it, for example `ssh`.
  source       String   @db.VarChar(16)
  /// The SHA-256 (hex) of the script that collected them; null for facts that were not collected by a script.
  scriptSha256 String?  @map("script_sha256") @db.VarChar(64)

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@map("server_facts")
}

/// Where Swellwright put a file of the artifact catalogue on a server: the user's home (`user`) or the root-owned
/// system directory (`system`). ADR 0039.
enum ArtifactDestination {
  user
  system

  @@map("artifact_destination")
}

/// What the last check of a copy on a server found: it hashes to the expected value, to another one, or is gone.
enum ArtifactCheckState {
  ok
  differs
  missing

  @@map("artifact_check_state")
}

/// A copy of an artifact version on a server, as Swellwright pushed it. One row per server, artifact and version:
/// the copy is immutable, so a version is either there or not. The path is what the push recorded; removing and
/// checking use it only after it is matched against the layout. No foreign key to the user who pushed it, like the
/// audit chain.
model ServerArtifact {
  id           String              @id @default(uuid(7)) @db.Uuid
  serverId     String              @map("server_id") @db.Uuid
  /// The artifact name and version of the catalogue at the time of the push.
  name         String              @db.VarChar(64)
  version      String              @db.VarChar(32)
  /// The SHA-256 (hex) the catalogue declared, which the copy was checked against, and its size in bytes.
  sha256       String              @db.VarChar(64)
  size         Int
  destination  ArtifactDestination @default(user)
  /// The absolute path of the file on the server.
  remotePath   String              @map("remote_path") @db.VarChar(1024)
  pushedAt     DateTime            @map("pushed_at") @db.Timestamptz(3)
  pushedById   String?             @map("pushed_by_id") @db.Uuid
  /// The last check after the push: when, what it found and what the copy hashed to (null when it was missing).
  verifiedAt   DateTime?           @map("verified_at") @db.Timestamptz(3)
  verifyState  ArtifactCheckState? @map("verify_state")
  remoteSha256 String?             @map("remote_sha256") @db.VarChar(64)

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, name, version])
  @@map("server_artifacts")
}
