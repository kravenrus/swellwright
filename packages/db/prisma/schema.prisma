// Swellwright data model. The design is docs/en/design/02-data-model.md; this file grows entity by entity.
// Tables and columns are snake_case in the database and camelCase in the client.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

/// Built-in roles (docs/en/design/05-security.md). Custom roles and permission sets come with the RBAC work.
enum UserRole {
  owner
  operator
  observer
  terminal
  auditor

  @@map("user_role")
}

enum UserStatus {
  active
  disabled

  @@map("user_status")
}

/// How far a session got. `password_verified` is usable only to finish signing in.
enum SessionStage {
  password_verified
  active

  @@map("session_stage")
}

model User {
  id          String     @id @default(uuid(7)) @db.Uuid
  /// Login name. Stored lower-case: the application normalizes it before every write.
  username    String     @unique @db.VarChar(32)
  displayName String?    @map("display_name") @db.VarChar(100)
  /// Optional. Stored lower-case, like the username.
  email       String?    @unique @db.VarChar(254)
  role        UserRole
  status      UserStatus @default(active)
  language    String     @default("en") @db.VarChar(16)
  theme       String     @default("dark") @db.VarChar(16)
  lastLoginAt DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  credential    Credential?
  recoveryCodes RecoveryCode[]
  sessions      Session[]

  @@map("users")
}

/// Sign-in secrets of one user (docs/en/design/02-data-model.md, ADR 0014).
model Credential {
  userId            String    @id @map("user_id") @db.Uuid
  /// Argon2id hash in PHC string format; carries its own salt and parameters.
  passwordHash      String    @map("password_hash")
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  /// TOTP secret sealed with the instance authentication key (AES-256-GCM). Null until enrollment starts.
  totpSecret        Bytes?    @map("totp_secret")
  /// Set when the user proved they hold the authenticator. Until then the secret is only a proposal.
  totpConfirmedAt   DateTime? @map("totp_confirmed_at") @db.Timestamptz(3)
  /// Time step of the last accepted code; a code is accepted only for a later step (no replay).
  totpLastStep      Int?      @map("totp_last_step")
  /// Consecutive failures of the password or the second step; reset on a completed sign-in.
  failedAttempts    Int       @default(0) @map("failed_attempts")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credentials")
}

/// One-time codes for a lost authenticator. Only SHA-256 hashes are stored.
model RecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.VarChar(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("recovery_codes")
}

/// A browser session. The cookie holds a random token; only its SHA-256 hash is stored.
model Session {
  id                String       @id @default(uuid(7)) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  tokenHash         String       @unique @map("token_hash") @db.VarChar(64)
  stage             SessionStage
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime     @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  /// Idle expiry, moved forward while the session is used.
  expiresAt         DateTime     @map("expires_at") @db.Timestamptz(3)
  /// The session ends here whatever its activity.
  absoluteExpiresAt DateTime     @map("absolute_expires_at") @db.Timestamptz(3)
  ip                String?      @db.VarChar(64)
  userAgent         String?      @map("user_agent") @db.VarChar(256)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}
