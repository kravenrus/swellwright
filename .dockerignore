# Keep the build context small and keep secrets and local state out of the image.
.git
.github
.turbo
**/node_modules
**/dist
**/*.tsbuildinfo
coverage

# Environment files: only the example is ever part of a build.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key

# Not needed to build the images.
docs
assets
examples
registry
plugins
scripts
**/*.md
