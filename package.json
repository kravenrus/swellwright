{
  "name": "swellwright",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source console and API for deploying and operating Remnawave fleets",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=26.0.0 <27",
    "pnpm": ">=10.34.9 <11"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run build && eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "hygiene": "python scripts/check-hygiene.py",
    "check": "pnpm run format && pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run test",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @swellwright/db run generate",
    "db:migrate:deploy": "pnpm --filter @swellwright/db run migrate:deploy",
    "db:migrate:dev": "pnpm --filter @swellwright/db run migrate:dev",
    "db:status": "pnpm --filter @swellwright/db run migrate:status",
    "db:schema:check": "pnpm --filter @swellwright/db run schema:check",
    "openapi": "turbo run build --filter=@swellwright/contracts && node scripts/openapi.mjs",
    "openapi:check": "turbo run build --filter=@swellwright/contracts && node scripts/openapi.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.10.1",
    "turbo": "2.11.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
